#!/bin/zsh
# term-menu: destination picker for new terminal windows.

tmenu_hosts() {
  local config="${SSH_CONFIG_FILE:-$HOME/.ssh/config}"
  [[ -r "$config" ]] || return 0
  local line rest h
  while IFS= read -r line; do
    line="${line%%\#*}"                                  # strip comments
    [[ "$line" =~ ^[[:space:]]*Host[[:space:]] ]] || continue
    rest="${line#*Host}"
    for h in ${=rest}; do                                # split multi-name lines
      [[ "$h" == *'*'* || "$h" == *'?'* || "$h" == *'!'* ]] && continue
      print -r -- "$h"
    done
  done < "$config" | sort -u
}

tmenu_entries() {
  command -v herdr >/dev/null 2>&1 && print -r -- "herdr"
  command -v tmux  >/dev/null 2>&1 && print -r -- "tmux"
  print -r -- "shell"
  local h
  for h in ${(f)"$(tmenu_hosts)"}; do
    print -r -- "ssh: $h"
  done
}

if [[ ${ZSH_EVAL_CONTEXT} == toplevel ]]; then
  main() { :; }
  main "$@"
fi
